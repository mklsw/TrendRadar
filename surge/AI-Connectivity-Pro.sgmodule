#!name=AI Connectivity Pro
#!desc=自用 AI 开发网络面板。默认 dashboard 聚焦 AI 可达性、出口/Wi-Fi 和轻量接口流量；full/指定 GROUP 可展开 AI、Dev、Work、China、DoH 检测。
#!author=Tom Wu & ChatGPT
#!homepage=https://github.com/mklsw/TrendRadar
#!arguments=TITLE:AI Connectivity Pro,UPDATE-INTERVAL:60,TIMEOUT:6000,ICON:network,ICON-COLOR:#00AEEF,MODE:dashboard,GROUP:all,SHOW-STATUS:true,SHOW-IP:true,IP-LOOKUP:cloudflare-ipapi,SHOW-TRAFFIC:false,SHOW-NODE:true,MASK:false,POLICIES:Homelab-Access|CN-Direct|WeChat-Homelab-SG|USHome|Global|AI-Bwg-USHome-Auto|Homelab-Core|Homelab-Backup|Homelab-SG,CUSTOM-CHECKS:,EVENT-SCRIPT-NAME:AI Connectivity Pro Network Changed,EVENT-DELAY:3
#!arguments-desc=TITLE:\n面板标题。\n\nUPDATE-INTERVAL:\n面板刷新间隔，单位秒。默认 60 秒。外部 AI/Dev/Work 探测不建议 1 秒刷新。\n\nTIMEOUT:\n单项检测超时时间，单位毫秒。建议 4000-8000。最大 15000；模块脚本 timeout 已预留到 20 秒。\n\nICON / ICON-COLOR:\nSurge 面板图标和颜色。\n\nMODE:\n面板模式。可选 dashboard、ai-only、full。\n\nGROUP:\n检测分组。默认 all。可选 all、ai、dev、work、china、dns、ops、network，也支持逗号组合。指定 network 时只显示本机/出口/流量/策略摘要。\n\nSHOW-STATUS / SHOW-IP / SHOW-TRAFFIC / SHOW-NODE:\n是否显示 HTTP 状态码、出口信息、接口流量、近期策略提示。\n\nIP-LOOKUP:\n出口查询来源。可选 off、cloudflare、cloudflare-ipapi。\n\nMASK:\n是否打码本机 IP 和出口 IP，true 或 false。\n\nPOLICIES:\n关注的自用策略名，用 | 分隔。\n\nCUSTOM-CHECKS:\n自定义运维检测，用 | 分隔多项，格式 name,url[,ok-statuses]。例：Company VPN,https://vpn.example.com,200|CoreDNS,http://192.168.240.46:8080/health,200|AutoCut,https://autocut.example.com/health,200|Feishu Bot,https://open.feishu.cn,200/403。飞书机器人 Webhook 不要写死在公开仓库里，只在模块参数中填。\n\nEVENT-SCRIPT-NAME / EVENT-DELAY:\n网络变化自动刷新脚本名称和延迟秒数；名称填 # 可禁用。

[Script]
AI_Connectivity_Pro = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/mklsw/TrendRadar/master/surge/ai-connectivity-panel.js,argument="title={{{TITLE}}}&icon={{{ICON}}}&color={{{ICON-COLOR}}}&timeout={{{TIMEOUT}}}&mode={{{MODE}}}&group={{{GROUP}}}&showStatus={{{SHOW-STATUS}}}&showIP={{{SHOW-IP}}}&ipLookup={{{IP-LOOKUP}}}&showTraffic={{{SHOW-TRAFFIC}}}&showNode={{{SHOW-NODE}}}&mask={{{MASK}}}&policies={{{POLICIES}}}&customChecks={{{CUSTOM-CHECKS}}}"
{{{EVENT-SCRIPT-NAME}}} = type=event,event-name=network-changed,timeout=20,script-path=https://raw.githubusercontent.com/mklsw/TrendRadar/master/surge/ai-connectivity-panel.js,argument="event=true&eventDelay={{{EVENT-DELAY}}}&title={{{TITLE}}}&icon={{{ICON}}}&color={{{ICON-COLOR}}}&timeout={{{TIMEOUT}}}&mode={{{MODE}}}&group={{{GROUP}}}&showStatus={{{SHOW-STATUS}}}&showIP={{{SHOW-IP}}}&ipLookup={{{IP-LOOKUP}}}&showTraffic={{{SHOW-TRAFFIC}}}&showNode={{{SHOW-NODE}}}&mask={{{MASK}}}&policies={{{POLICIES}}}&customChecks={{{CUSTOM-CHECKS}}}"

[Panel]
# AI开发与运维连通性检测
AI_Connectivity_Pro = script-name=AI_Connectivity_Pro,update-interval={{{UPDATE-INTERVAL}}}
