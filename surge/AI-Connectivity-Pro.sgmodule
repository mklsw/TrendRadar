#!name=AI Connectivity Pro
#!desc=自用 AI 开发网络面板。默认 dashboard 聚焦 AI 可达性、出口/Wi-Fi 和轻量接口流量；full/指定 GROUP 可展开 AI、Dev、Work、China、DoH 检测。
#!author=Tom Wu & ChatGPT
#!homepage=https://github.com/mklsw/TrendRadar
#!arguments=TITLE:AI Connectivity Pro,UPDATE-INTERVAL:60,TIMEOUT:6000,ICON:network,ICON-COLOR:#00AEEF,MODE:dashboard,GROUP:all,SHOW-STATUS:true,SHOW-IP:true,IP-LOOKUP:cloudflare-ipapi,SHOW-TRAFFIC:true,SHOW-NODE:true,POLICIES:Homelab-Access|CN-Direct|WeChat-Homelab-SG|USHome|Global|AI-Bwg-USHome-Auto|Homelab-Core|Homelab-Backup|Homelab-SG
#!arguments-desc=TITLE:\n面板标题。\n\nUPDATE-INTERVAL:\n面板刷新间隔，单位秒。默认 60 秒。外部 AI/Dev/Work 探测不建议 1 秒刷新。\n\nTIMEOUT:\n单项检测超时时间，单位毫秒。建议 4000-8000。最大 15000；模块脚本 timeout 已预留到 20 秒。\n\nICON:\nSurge 面板图标，例如 network、timer、wifi.router。\n\nICON-COLOR:\nSurge 面板图标颜色，例如 #00AEEF。Surge 会自动处理模块参数里的 #。\n\nMODE:\n面板模式。可选 dashboard、ai-only、full。dashboard 为默认首页视图；ai-only 只看 AI；full 展开全部检测组。\n\nGROUP:\n检测分组。默认 all。可选 all、ai、dev、work、china、network、dns，也支持逗号组合，例如 ai,dev,work。指定 network 时只显示本机/出口/流量/策略摘要。\n\nSHOW-STATUS:\n是否显示 HTTP 状态码，true 或 false。\n\nSHOW-IP:\n是否查询并显示出口 IP，true 或 false。\n\nIP-LOOKUP:\n出口查询来源。可选 off、cloudflare、cloudflare-ipapi。cloudflare 只查 1.1.1.1 trace；cloudflare-ipapi 会继续用 ip-api.com 补充城市、ISP、ASN。\n\nSHOW-TRAFFIC:\n是否显示 Surge 本地 /v1/traffic 的接口流量摘要，true 或 false。\n\nSHOW-NODE:\n是否尝试从 Surge recent requests 推断近期策略/节点，并显示 POLICIES 中的关注策略，true 或 false。\n\nPOLICIES:\n关注的自用策略名，用 | 分隔。

[Script]
AI_Connectivity_Pro = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/mklsw/TrendRadar/master/surge/ai-connectivity-panel.js,argument="title={{{TITLE}}}&icon={{{ICON}}}&color={{{ICON-COLOR}}}&timeout={{{TIMEOUT}}}&mode={{{MODE}}}&group={{{GROUP}}}&showStatus={{{SHOW-STATUS}}}&showIP={{{SHOW-IP}}}&ipLookup={{{IP-LOOKUP}}}&showTraffic={{{SHOW-TRAFFIC}}}&showNode={{{SHOW-NODE}}}&policies={{{POLICIES}}}"

[Panel]
# AI开发与运维连通性检测
AI_Connectivity_Pro = script-name=AI_Connectivity_Pro,update-interval={{{UPDATE-INTERVAL}}}
